---
import '../styles/global.css';
import Seo from '../../../../shared/components/Seo.astro';
import { RESTO_BASE, RESTO_ORIGIN } from '../../../../shared/config.mjs';

interface Props { titulo: string; descripcion: string; }
const { titulo, descripcion } = Astro.props;
---
<!doctype html>
<html lang="es-AR">
  <head>
    <Seo base={RESTO_BASE} origen={RESTO_ORIGIN} titulo={titulo} descripcion={descripcion}
         imagen="img/og-resto.jpg" colorTema="#1F2227" />
  </head>
  <body class="bg-crema">
    <a href="#contenido" class="saltar-al-contenido">Saltar al contenido</a>
    <slot />
    <script>
      import '../../../../shared/animaciones.ts';
    </script>
  </body>
</html>
