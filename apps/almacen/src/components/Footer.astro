---
import Icono from '../../../../shared/components/Icono.astro';
import { ALMACEN_BASE, RESTO_URL, asset } from '../../../../shared/config.mjs';
import { ALMACEN, RESTO } from '../../../../shared/negocio.mjs';
import { RUTAS } from '../tienda/rutas';
const anio = new Date().getFullYear();
---
<footer class="relative overflow-hidden bg-oliva-2 pt-16 pb-24 text-crema-alm/90 [--foco:#CDDCB5] sm:pb-16">
  <div class="relative mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 md:grid-cols-[1.4fr_1fr_1fr] lg:px-8">
    <div>
      <div class="flex items-center gap-3">
        <span class="rounded-2xl bg-salvia px-3 py-2"><img src={asset(ALMACEN_BASE, 'img/lapan-logo-oliva.svg')} alt="Lapan" width="120" height="44" class="h-10 w-auto" /></span>
        <span class="font-display text-2xl font-semibold text-salvia italic">Almacén</span>
      </div>
      <p class="mt-4 max-w-sm">Panes sin gluten, hierbas a granel, huevos de gallinas libres y elaborados caseros, con delivery en Paraná.</p>
    </div>
    <div>
      <h2 class="font-sans text-sm font-bold tracking-wider text-salvia uppercase">Horarios</h2>
      <ul class="mt-4 grid gap-2">
        <li>{ALMACEN.horario.corto}</li>
        <li>Delivery: {ALMACEN.delivery.toLowerCase()}</li>
      </ul>
    </div>
    <div>
      <h2 class="font-sans text-sm font-bold tracking-wider text-salvia uppercase">Lapan</h2>
      <ul class="mt-4 grid gap-2">
        <li><a class="inline-flex items-center gap-2 hover:text-salvia" href={RUTAS.tienda}><Icono nombre="canasta" class="size-4" />Hacer un pedido</a></li>
        <li><a class="inline-flex items-center gap-2 hover:text-salvia" href={ALMACEN.whatsapp.url} target="_blank" rel="noopener"><Icono nombre="whatsapp" class="size-4" />Consultas por WhatsApp</a></li>
        <li><a class="inline-flex items-center gap-2 hover:text-salvia" href={ALMACEN.instagram.url} target="_blank" rel="noopener"><Icono nombre="instagram" class="size-4" />{ALMACEN.instagram.usuario}</a></li>
        <li><a class="inline-flex items-center gap-2 hover:text-salvia" href={RESTO.instagram.url} target="_blank" rel="noopener"><Icono nombre="instagram" class="size-4" />{RESTO.instagram.usuario}</a></li>
        <li><a class="inline-flex items-center gap-2 hover:text-salvia" href={RESTO_URL}><Icono nombre="flechaIzq" class="size-4" />Volver al restaurante</a></li>
      </ul>
    </div>
  </div>
  <div class="relative mx-auto mt-12 flex max-w-7xl flex-col gap-2 border-t border-white/15 px-4 pt-6 text-sm text-crema-alm/70 sm:flex-row sm:justify-between sm:px-6 lg:px-8">
    <p>© {anio} Lapan Almacén · Paraná, Entre Ríos</p>
    <p>Hecho con cariño en Paraná</p>
  </div>
</footer>
