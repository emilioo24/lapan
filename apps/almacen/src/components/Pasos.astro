---
import Icono from '../../../../shared/components/Icono.astro';
import { ALMACEN } from '../../../../shared/negocio.mjs';
import { RUTAS } from '../tienda/rutas';

// TODO: confirmar con el cliente cómo se paga y si el delivery tiene costo o zona de cobertura.
const pasos = [
  { icono: 'canasta', titulo: 'Elegí', texto: 'Armá tu pedido con lo que quieras del almacén.' },
  { icono: 'check', titulo: 'Confirmá', texto: 'Elegí día y horario, y pagá online o al recibir.' },
  { icono: 'moto', titulo: 'Te lo llevamos', texto: `Lo recibís en tu casa. Delivery ${ALMACEN.delivery.toLowerCase()}.` },
];
---
<section id="como-pedir" class="relative overflow-hidden bg-oliva py-20 text-white [--foco:#CDDCB5] sm:py-24" aria-labelledby="titulo-pasos">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="sobretitulo justify-center text-salvia">Cómo pedir</p>
      <h2 id="titulo-pasos" class="mt-3 text-4xl font-extrabold sm:text-5xl">Pedí en <em class="text-salvia">tres pasos</em></h2>
    </div>

    <ol class="pasos relative mt-14 grid gap-10 md:grid-cols-3 md:gap-6" data-reveal>
      <svg class="linea pointer-events-none absolute top-9 hidden md:block" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 5 Q 25 -2 50 5 T 100 5" fill="none" stroke="#CDDCB5" stroke-width="1.2" stroke-dasharray="2 2.4" vector-effect="non-scaling-stroke" pathLength="100" />
      </svg>
      {pasos.map((p, i) => (
        <li class="paso relative text-center" style={`--i:${i}`}>
          <div class="relative mx-auto grid size-18 place-items-center rounded-full bg-salvia text-oliva-2 shadow-[0_0_0_8px_rgba(205,220,181,.18)]">
            <Icono nombre={p.icono} class="size-8" />
            <span class="absolute -top-1 -right-1 grid size-8 place-items-center rounded-full bg-fucsia font-display text-lg font-extrabold text-white">{i + 1}</span>
          </div>
          <h3 class="mt-5 text-2xl font-semibold">{p.titulo}</h3>
          <p class="mx-auto mt-2 max-w-xs text-white/90">{p.texto}</p>
        </li>
      ))}
    </ol>

    <div class="mt-14 text-center" data-reveal>
      <a href={RUTAS.tienda} class="btn btn-salvia text-lg"><Icono nombre="canasta" /> Empezá tu pedido</a>
    </div>
  </div>
</section>

<style>
  .linea { left: 16.66%; right: 16.66%; width: 66.66%; height: 20px; }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .pasos .linea path { stroke-dashoffset: 100; transition: stroke-dashoffset 1.6s var(--ease-suave) .3s; }
    :global(html.js) .pasos.is-visible .linea path { stroke-dashoffset: 0; }
    :global(html.js) .pasos .paso { opacity: 0; transform: translateY(24px) scale(.95); transition: opacity .7s, transform .8s var(--ease-rebote); transition-delay: calc(var(--i) * 280ms + 200ms); }
    :global(html.js) .pasos.is-visible .paso { opacity: 1; transform: none; }
  }
</style>
