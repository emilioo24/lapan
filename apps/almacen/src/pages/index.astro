---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Categorias from '../components/Categorias.astro';
import Pasos from '../components/Pasos.astro';
import Horarios from '../components/Horarios.astro';
import Footer from '../components/Footer.astro';
import Guarda from '../../../../shared/components/Guarda.astro';
import BotonPedido from '../tienda/BotonPedido';
import { RUTAS } from '../tienda/rutas';
---
<Base
  titulo="Lapan Almacén · Panes sin gluten, granel y delivery en Paraná"
  descripcion="Panes y pan dulce sin gluten, hierbas y hebras a granel, huevos de gallinas libres y elaborados caseros. Hacé tu pedido online: delivery de lunes a sábado en Paraná."
>
  <Navbar />
  <main id="contenido">
    <Hero />
    <Guarda variante="oliva" />
    <Categorias />
    <Pasos />
    <Horarios />
  </main>
  <Footer />
  <BotonPedido client:load href={RUTAS.tienda} variante="flotante" />
</Base>
