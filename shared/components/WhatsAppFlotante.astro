---
import Icono from './Icono.astro';
interface Props { url: string; etiqueta: string; }
const { url, etiqueta } = Astro.props;
---
<a href={url} target="_blank" rel="noopener" aria-label={etiqueta}
   class="wa-flotante fixed right-4 bottom-4 z-40 grid size-15 place-items-center rounded-full bg-[#25D366] text-[#0b3d1f] shadow-[0_10px_30px_-6px_rgba(0,0,0,.45)] sm:right-6 sm:bottom-6">
  <span class="wa-onda" aria-hidden="true"></span>
  <Icono nombre="whatsapp" class="relative size-8" />
  <span class="wa-tip" aria-hidden="true">{etiqueta}</span>
</a>

<style>
  .wa-flotante { animation: latido 5s ease-in-out 3s infinite; transition: transform .25s var(--ease-rebote); }
  .wa-flotante:hover { transform: scale(1.08); animation: none; }
  .wa-onda { position: absolute; inset: 0; border-radius: 999px; background: #25D366; animation: onda 2.6s ease-out 1.5s infinite; }
  .wa-tip {
    position: absolute; right: calc(100% + .75rem); white-space: nowrap;
    background: var(--color-tinta); color: #fff; font-weight: 500; font-size: .9rem;
    padding: .45rem .8rem; border-radius: 999px;
    opacity: 0; transform: translateX(6px); pointer-events: none;
    transition: opacity .2s, transform .2s;
  }
  @media (hover: hover) {
    .wa-flotante:hover .wa-tip, .wa-flotante:focus-visible .wa-tip { opacity: 1; transform: none; }
  }
</style>
